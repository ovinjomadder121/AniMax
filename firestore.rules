rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ovinjomadder@gmail.com';
    }

    function isValidPhoto(data) {
      return data.url is string && data.url.size() < 1048576 
             && data.title is string && data.title.size() > 0 && data.title.size() <= 200
             && data.createdAt == request.time;
    }

    match /photos/{photoId} {
      // Public can explore and update views
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
      
      // Only admin can create or delete
      allow create: if isAdmin() && isValidPhoto(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
